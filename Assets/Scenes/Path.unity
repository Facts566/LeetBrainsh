    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "> |-> Move pointer right\n< |-> Move pointer left\n+ |-> Increment cell\n-
    |-> Decrement cell\n. |-> Output character\n[ |-> Start loop if not 0\n] |->
    End loop if 0\n( |-> Run block once if the cell holds a digit (48-57, '0'-'9')\n)
    |-> End the condition block\n# |-> Output number\nN |-> Subtract 48 (character
    \u2192 number)\nS |-> Add 48 (number \u2192 character)\nd |-> Places the remainder
    of the division by 10 into the next cell\nm |-> Multiply the current cell by
    the cell on the right\n:n |-> Repeat + n times\n;n |-> Repeat - n times\n{ ...
    } |-> Comment"
